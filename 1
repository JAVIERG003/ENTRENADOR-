<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Planificador de Entrenamientos</title>
<style>
  :root{
    --bg:#0f1724; --card:#0b1220; --accent:#06b6d4; --muted:#94a3b8; --glass: rgba(255,255,255,0.03);
    --success:#10b981; --danger:#ef4444; --text:#e6eef6;
  }
  *{box-sizing:border-box;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial;}
  body{margin:0;background:linear-gradient(180deg,#071028 0%, #071a2a 60%);color:var(--text);min-height:100vh;}
  header{display:flex;align-items:center;justify-content:space-between;padding:18px 28px;border-bottom:1px solid rgba(255,255,255,0.03);backdrop-filter: blur(6px);}
  .brand{display:flex;align-items:center;gap:12px}
  .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#7c3aed);display:flex;align-items:center;justify-content:center;font-weight:700;color:#021022}
  h1{font-size:18px;margin:0}
  .user-welcome{font-size:14px;color:var(--muted)}
  .container{display:flex;gap:20px;padding:20px;max-width:1200px;margin:20px auto;}
  .sidebar{width:300px;background:linear-gradient(180deg,var(--card),#071226);border-radius:12px;padding:16px;box-shadow:0 6px 20px rgba(2,6,23,0.6)}
  .main{flex:1;background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));border-radius:12px;padding:18px;min-height:520px}
  .section-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
  .btn{background:var(--accent);color:#021022;padding:8px 12px;border-radius:8px;border:none;cursor:pointer;font-weight:600}
  .btn.ghost{background:transparent;border:1px solid rgba(255,255,255,0.04);color:var(--text)}
  .weeks-list{display:flex;flex-direction:column;gap:8px;max-height:420px;overflow:auto;padding-right:6px}
  .week-item{display:flex;align-items:center;justify-content:space-between;padding:10px;border-radius:8px;background:var(--glass);cursor:pointer;border:1px solid rgba(255,255,255,0.02)}
  .week-item.active{outline:2px solid rgba(6,182,212,0.12);box-shadow:0 6px 18px rgba(6,182,212,0.06)}
  .small{font-size:13px;color:var(--muted)}
  .days{display:flex;gap:12px;flex-wrap:wrap}
  .day-card{background:linear-gradient(180deg,#071a2a, #071226);padding:12px;border-radius:10px;min-width:220px;flex:1;border:1px solid rgba(255,255,255,0.03)}
  .day-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
  .ex-list{display:flex;flex-direction:column;gap:8px;max-height:320px;overflow:auto;padding-right:6px}
  .ex-item{background:linear-gradient(90deg, rgba(255,255,255,0.01), rgba(255,255,255,0.02));padding:8px;border-radius:8px;border:1px solid rgba(255,255,255,0.02);display:flex;flex-direction:column;gap:6px}
  .ex-top{display:flex;align-items:center;justify-content:space-between}
  .muted{color:var(--muted);font-size:13px}
  .series-row{display:flex;gap:8px;align-items:center}
  input[type="text"], select, input[type="number"]{background:transparent;border:1px solid rgba(255,255,255,0.04);padding:8px;border-radius:8px;color:var(--text);width:100%}
  .modal{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(2,6,23,0.6);z-index:60;backdrop-filter: blur(4px)}
  .modal-card{width:920px;max-width:95%;background:linear-gradient(180deg,#071226,#071226);padding:18px;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}
  .grid{display:grid;grid-template-columns:1fr 320px;gap:12px}
  .search{display:flex;gap:8px;margin-bottom:8px}
  .list-ex{max-height:420px;overflow:auto;border-radius:8px;padding:6px;background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.02))}
  .exercise-row{padding:8px;border-radius:8px;border:1px solid rgba(255,255,255,0.02);display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
  .footer{display:flex;gap:8px;justify-content:flex-end;margin-top:12px}
  .pill{padding:6px 8px;border-radius:999px;background:rgba(255,255,255,0.02);font-size:13px}
  .top-actions{display:flex;gap:8px;align-items:center}
  .empty{color:var(--muted);padding:18px;border-radius:8px;background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.02))}
  .search-input{padding:8px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--text);width:100%}
  .rename{background:transparent;border:none;color:var(--muted);cursor:pointer}
  .controls{display:flex;gap:8px;align-items:center}
  .file-input{display:none}
  /* scrollbar */
  .list-ex::-webkit-scrollbar, .weeks-list::-webkit-scrollbar, .ex-list::-webkit-scrollbar {width:8px}
  .list-ex::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.03);border-radius:8px}
  @media (max-width:900px){.container{flex-direction:column;padding:12px}.sidebar{width:100%}}
</style>
</head>
<body>
<header>
  <div class="brand">
    <div class="logo">PT</div>
    <div>
      <h1>Planificador de Entrenamientos</h1>
      <div class="user-welcome" id="welcomeSmall">Bienvenido</div>
    </div>
  </div>
  <div class="top-actions">
    <button class="btn" id="openExercisesBtn">Ejercicios</button>
    <button class="btn ghost" id="exportBtn" title="Exportar datos">Exportar datos</button>
    <button class="btn ghost" id="importBtn" title="Importar datos">Importar datos</button>
    <button class="btn ghost" id="downloadHtmlBtn" title="Descargar HTML">Descargar HTML</button>
    <button class="btn ghost" id="shareDataBtn" title="Copiar JSON">Compartir</button>
    <button class="btn ghost" id="resetBtn">Restablecer datos</button>
  </div>
</header>

<div class="container">
  <aside class="sidebar">
    <div class="section-title">
      <div>
        <strong>Semanas</strong>
        <div class="small">Organiza tu plan por semanas</div>
      </div>
      <div class="controls">
        <button class="btn" id="addWeekBtn">+ Semana</button>
      </div>
    </div>
    <div class="weeks-list" id="weeksList"></div>
    <hr style="border:none;height:1px;background:rgba(255,255,255,0.02);margin:12px 0">
    <div>
      <strong>Usuario</strong>
      <div style="display:flex;gap:8px;margin-top:8px">
        <div style="flex:1">
          <input id="nameInput" type="text" placeholder="Tu nombre" />
        </div>
        <button class="btn" id="saveNameBtn">Guardar</button>
      </div>
      <div class="small" style="margin-top:8px">Tu nombre aparece en la cabecera y se guarda localmente.</div>
    </div>
  </aside>

  <main class="main">
    <div class="section-title">
      <div>
        <strong id="mainTitle">Plan de entrenamiento</strong>
        <div class="small" id="subtitle">Selecciona o crea una semana</div>
      </div>
      <div class="controls">
        <button class="btn ghost" id="addDayBtn">+ Día</button>
        <button class="btn ghost" id="renameWeekBtn">Renombrar semana</button>
        <button class="btn ghost" id="deleteWeekBtn" style="color:var(--danger);border-color:rgba(239,68,68,0.12)">Eliminar</button>
      </div>
    </div>

    <div id="contentArea">
      <div class="empty" id="emptyMsg">No hay semanas. Pulsa <strong>+ Semana</strong> para empezar.</div>
      <div class="days" id="daysContainer" style="display:none"></div>
    </div>
  </main>
</div>

<!-- Modal: Añadir ejercicio -->
<div id="exerciseModal" class="modal" style="display:none">
  <div class="modal-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
      <div>
        <strong>Añadir ejercicio</strong>
        <div class="small">Selecciona un ejercicio y configura series</div>
      </div>
      <div><button class="btn ghost" id="closeExerciseModal">Cerrar</button></div>
    </div>

    <div class="grid">
      <div>
        <div class="search">
          <input id="exerciseSearch" class="search-input" placeholder="Buscar ejercicio..." />
          <button class="btn ghost" id="addCustomExerciseBtn">+ Personalizado</button>
        </div>
        <div class="list-ex" id="exerciseList"></div>
      </div>

      <div>
        <div style="background:linear-gradient(180deg,#071a2a,#071226);padding:12px;border-radius:8px;border:1px solid rgba(255,255,255,0.03)">
          <div><strong id="selectedExerciseTitle">Ninguno seleccionado</strong></div>
          <div class="small" id="selectedExerciseType">Elige un ejercicio para configurar</div>

          <div style="margin-top:12px">
            <label class="small">Series</label>
            <input id="seriesCount" type="number" min="1" value="3" />
          </div>

          <div style="margin-top:8px">
            <label class="small">Tipo de series</label>
            <select id="seriesType">
              <option value="lineal">Lineales</option>
              <option value="descendente">Descendentes</option>
              <option value="pirámide">Pirámide</option>
              <option value="rest-pause">Rest-Pause</option>
              <option value="isométrico">Isométrico</option>
            </select>
          </div>

          <div style="margin-top:12px">
            <div class="small">Configuración por serie</div>
            <div id="seriesConfigArea" style="margin-top:8px;display:flex;flex-direction:column;gap:8px;max-height:260px;overflow:auto"></div>
          </div>

          <div class="footer">
            <button class="btn ghost" id="cancelAddExercise">Cancelar</button>
            <button class="btn" id="confirmAddExercise">Añadir al día</button>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Modal: Ejercicios (listado completo) -->
<div id="exercisesModal" class="modal" style="display:none">
  <div class="modal-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
      <div>
        <strong>Ejercicios</strong>
        <div class="small">Listado completo de ejercicios (puedes añadir personalizados)</div>
      </div>
      <div><button class="btn ghost" id="closeExercisesModal">Cerrar</button></div>
    </div>

    <div style="display:flex;gap:12px">
      <div style="flex:1">
        <input id="globalExerciseSearch" class="search-input" placeholder="Buscar en todos los ejercicios..." />
        <div class="list-ex" id="globalExerciseList" style="margin-top:8px;max-height:520px"></div>
      </div>
      <div style="width:320px">
        <div style="background:linear-gradient(180deg,#071a2a,#071226);padding:12px;border-radius:8px;border:1px solid rgba(255,255,255,0.03)">
          <strong>Añadir ejercicio personalizado</strong>
          <div style="margin-top:8px">
            <input id="customExerciseName" type="text" placeholder="Nombre del ejercicio" />
            <div style="margin-top:8px;display:flex;gap:8px">
              <button class="btn" id="saveCustomExercise">Guardar</button>
              <button class="btn ghost" id="clearCustomExercise">Limpiar</button>
            </div>
            <div class="small" style="margin-top:8px">Los ejercicios personalizados se guardan localmente.</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Input oculto para importar -->
<input id="fileInput" class="file-input" type="file" accept="application/json" />

