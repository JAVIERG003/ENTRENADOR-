(function ensure400(){
  let arr = DEFAULT_EXERCISES;
  let i=0;
  while(arr.length<400){
    arr.push(arr[i % arr.length] + " (var " + Math.floor(i/arr.length+1) + ")");
    i++;
  }
  window.DEFAULT_EXERCISES = arr.slice(0,400);
})();

/* ======= Estado y utilidades ======= */
const STORAGE_KEY = 'planador_data_v1';
const NAME_KEY = 'planador_nombre_v1';
const EXERCISES_KEY = 'planador_exercises_v1';

let state = {
  name: localStorage.getItem(NAME_KEY) || '',
  weeks: [],
  exercises: JSON.parse(localStorage.getItem(EXERCISES_KEY) || 'null') || window.DEFAULT_EXERCISES.slice()
};

function saveState(){ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); localStorage.setItem(EXERCISES_KEY, JSON.stringify(state.exercises)); }
function loadState(){
  const raw = localStorage.getItem(STORAGE_KEY);
  if(raw){ try{ state = JSON.parse(raw); }catch(e){ console.error(e); } }
  state.exercises = state.exercises || window.DEFAULT_EXERCISES.slice();
}
loadState();

/* ======= Helpers ======= */
function uid(prefix='id'){ return prefix + '_' + Math.random().toString(36).slice(2,9); }
function el(tag,attrs={},...children){ const e=document.createElement(tag); for(let k in attrs){ if(k.startsWith('on') && typeof attrs[k]==='function') e.addEventListener(k.slice(2),attrs[k]); else if(k==='html') e.innerHTML=attrs[k]; else e.setAttribute(k,attrs[k]); } children.flat().forEach(c=>{ if(c==null) return; if(typeof c==='string') e.appendChild(document.createTextNode(c)); else e.appendChild(c); }); return e; }

/* ======= Render UI ======= */
const weeksList = document.getElementById('weeksList');
const daysContainer = document.getElementById('daysContainer');
const emptyMsg = document.getElementById('emptyMsg');
const mainTitle = document.getElementById('mainTitle');
const subtitle = document.getElementById('subtitle');
const welcomeSmall = document.getElementById('welcomeSmall');
const nameInput = document.getElementById('nameInput');
const saveNameBtn = document.getElementById('saveNameBtn');

let activeWeekId = state.weeks.length ? state.weeks[0].id : null;

function renderHeaderName(){
  welcomeSmall.textContent = state.name ? `Hola, ${state.name}` : 'Bienvenido';
  document.getElementById('nameInput').value = state.name || '';
  mainTitle.textContent = state.name ? `${state.name} — Plan de entrenamiento` : 'Plan de entrenamiento';
}
renderHeaderName();

function renderWeeks(){
  weeksList.innerHTML = '';
  if(state.weeks.length===0){
    emptyMsg.style.display='block';
    daysContainer.style.display='none';
    subtitle.textContent = 'Selecciona o crea una semana';
    return;
  }
  emptyMsg.style.display='none';
  daysContainer.style.display='flex';
  state.weeks.forEach(w=>{
    const item = el('div',{class:'week-item' + (w.id===activeWeekId ? ' active' : ''), onclick:()=>{ activeWeekId=w.id; renderWeeks(); renderDays(); }});
    const left = el('div',{}, el('div',{style:'font-weight:700'}, w.title || 'Semana'), el('div',{class:'small'}, `${w.days.length} días`));
    const right = el('div',{}, 
      el('button',{class:'rename', onclick:(e)=>{ e.stopPropagation(); renameWeek(w.id); }}, '✎'),
      el('button',{class:'rename', onclick:(e)=>{ e.stopPropagation(); deleteWeek(w.id); }}, '🗑')
    );
    item.appendChild(left); item.appendChild(right);
    weeksList.appendChild(item);
  });
  const addHint = el('div',{class:'small', style:'margin-top:10px;color:var(--muted)'}, 'Pulsa una semana para editarla. Usa + Semana para crear una nueva.');
  weeksList.appendChild(addHint);
}

function renderDays(){
  const week = state.weeks.find(w=>w.id===activeWeekId);
  if(!week){ daysContainer.innerHTML=''; return; }
  subtitle.textContent = week.title || 'Semana';
  daysContainer.innerHTML = '';
  week.days.forEach(day=>{
    const card = el('div',{class:'day-card'});
    const header = el('div',{class:'day-header'}, el('div',{}, el('strong',{}, day.title || 'Día'), el('div',{class:'small'}, `${day.exercises.length} ejercicios`)),
      el('div',{}, 
        el('button',{class:'rename', onclick:()=>renameDay(week.id,day.id)}, '✎'),
        el('button',{class:'rename', onclick:()=>deleteDay(week.id,day.id)}, '🗑')
      )
    );
    card.appendChild(header);
    const exList = el('div',{class:'ex-list'});
    if(day.exercises.length===0){
      exList.appendChild(el('div',{class:'empty'}, 'No hay ejercicios. Pulsa "Añadir ejercicio"'));
    } else {
      day.exercises.forEach(ex=>{
        const exItem = el('div',{class:'ex-item'});
        const top = el('div',{class:'ex-top'}, el('div',{}, el('strong',{}, ex.name), el('div',{class:'muted'}, ex.seriesType + ' • ' + ex.series.length + ' series')), 
          el('div',{}, el('button',{class:'rename', onclick:()=>editExercise(week.id,day.id,ex.id)}, '✎'), el('button',{class:'rename', onclick:()=>removeExercise(week.id,day.id,ex.id)}, '🗑'))
        );
        exItem.appendChild(top);
        ex.series.forEach((s,i)=>{
          const srow = el('div',{class:'series-row'}, el('div',{style:'width:40%'}, el('div',{class:'small'}, `Serie ${i+1}`), el('div',{}, s.reps || s.time || '-')), el('div',{style:'width:25%'}, el('div',{class:'small'}, 'Peso'), el('div',{}, s.weight || '-')), el('div',{style:'width:25%'}, el('div',{class:'small'}, 'Descanso'), el('div',{}, s.rest || '-')));
          exItem.appendChild(srow);
        });
        if(ex.notes) exItem.appendChild(el('div',{class:'small'}, 'Notas: ' + ex.notes));
        exList.appendChild(exItem);
      });
    }
    const addBtn = el('div',{style:'margin-top:8px;display:flex;gap:8px;justify-content:space-between;align-items:center'}, el('div',{class:'small'}, ''), el('div',{}, el('button',{class:'btn', onclick:()=>openAddExerciseModal(week.id,day.id)}, 'Añadir ejercicio')));
    card.appendChild(exList);
    card.appendChild(addBtn);
    daysContainer.appendChild(card);
  });
}

/* ======= CRUD Semanas y Días ======= */
document.getElementById('addWeekBtn').addEventListener('click', ()=>{
  const id = uid('week');
  const title = prompt('Nombre de la semana:', `Semana ${state.weeks.length+1}`) || `Semana ${state.weeks.length+1}`;
  const week = {id,title,days:[]};
  state.weeks.push(week);
  activeWeekId = id;
  saveState(); renderWeeks(); renderDays();
});

function renameWeek(weekId){
  const w = state.weeks.find(x=>x.id===weekId);
  if(!w) return;
  const newName = prompt('Nuevo nombre de la semana:', w.title) || w.title;
  w.title = newName;
  saveState(); renderWeeks(); renderDays();
}
function deleteWeek(weekId){
  if(!confirm('¿Eliminar esta semana y todo su contenido?')) return;
  state.weeks = state.weeks.filter(w=>w.id!==weekId);
  activeWeekId = state.weeks.length ? state.weeks[0].id : null;
  saveState(); renderWeeks(); renderDays();
}

document.getElementById('addDayBtn').addEventListener('click', ()=>{
  const week = state.weeks.find(w=>w.id===activeWeekId);
  if(!week){ alert('Selecciona o crea una semana primero.'); return; }
  const id = uid('day');
  const title = prompt('Nombre del día:', `Día ${week.days.length+1}`) || `Día ${week.days.length+1}`;
  week.days.push({id,title,exercises:[]});
  saveState(); renderWeeks(); renderDays();
});

function renameDay(weekId,dayId){
  const w = state.weeks.find(x=>x.id===weekId);
  if(!w) return;
  const d = w.days.find(x=>x.id===dayId);
  if(!d) return;
  const newName = prompt('Nuevo nombre del día:', d.title) || d.title;
  d.title = newName;
  saveState(); renderDays();
}
function deleteDay(weekId,dayId){
  if(!confirm('¿Eliminar este día y sus ejercicios?')) return;
  const w = state.weeks.find(x=>x.id===weekId);
  if(!w) return;
  w.days = w.days.filter(d=>d.id!==dayId);
  saveState(); renderDays();
}

/* ======= Añadir / Editar ejercicios en un día ======= */
const exerciseModal = document.getElementById('exerciseModal');
const exerciseListEl = document.getElementById('exerciseList');
const exerciseSearch = document.getElementById('exerciseSearch');
const selectedExerciseTitle = document.getElementById('selectedExerciseTitle');
const selectedExerciseType = document.getElementById('selectedExerciseType');
const seriesCountInput = document.getElementById('seriesCount');
const seriesTypeSelect = document.getElementById('seriesType');
const seriesConfigArea = document.getElementById('seriesConfigArea');
const confirmAddExercise = document.getElementById('confirmAddExercise');
const cancelAddExercise = document.getElementById('cancelAddExercise');
const closeExerciseModal = document.getElementById('closeExerciseModal');
const addCustomExerciseBtn = document.getElementById('addCustomExerciseBtn');

let modalContext = {weekId:null, dayId:null, editingExerciseId:null, selectedExerciseName:null};

function openAddExerciseModal(weekId, dayId, editingExerciseId=null){
  modalContext = {weekId, dayId, editingExerciseId, selectedExerciseName:null};
  exerciseModal.style.display='flex';
  selectedExerciseTitle.textContent = 'Ninguno seleccionado';
  selectedExerciseType.textContent = 'Elige un ejercicio';
  seriesCountInput.value = 3;
  seriesTypeSelect.value = 'lineal';
  seriesConfigArea.innerHTML = '';
  renderExerciseList();
}

function closeModal(){
  exerciseModal.style.display='none';
  modalContext = {weekId:null, dayId:null, editingExerciseId:null, selectedExerciseName:null};
}
closeExerciseModal.addEventListener('click', closeModal);
cancelAddExercise.addEventListener('click', closeModal);

function renderExerciseList(filter=''){
  exerciseListEl.innerHTML = '';
  const list = state.exercises.filter(e=>e.toLowerCase().includes(filter.toLowerCase()));
  list.forEach(name=>{
    const row = el('div',{class:'exercise-row'}, el('div',{}, el('div',{}, name), el('div',{class:'small'}, '')), el('div',{}, el('button',{class:'btn ghost', onclick:()=>selectExercise(name)}, 'Seleccionar')));
    exerciseListEl.appendChild(row);
  });
  if(list.length===0) exerciseListEl.appendChild(el('div',{class:'small'}, 'No se encontraron ejercicios'));
}
exerciseSearch.addEventListener('input', ()=>renderExerciseList(exerciseSearch.value));

function selectExercise(name){
  modalContext.selectedExerciseName = name;
  selectedExerciseTitle.textContent = name;
  selectedExerciseType.textContent = 'Ejercicio seleccionado';
  buildSeriesConfig();
}

function buildSeriesConfig(){
  const n = Math.max(1, parseInt(seriesCountInput.value) || 1);
  seriesConfigArea.innerHTML = '';
  for(let i=0;i<n;i++){
    const row = el('div',{style:'display:flex;gap:8px;align-items:center'}, 
      el('div',{style:'flex:1'}, el('input',{type:'text', placeholder:'Reps o tiempo (ej. 8, 45s)', value:''})),
      el('div',{style:'width:110px'}, el('input',{type:'text', placeholder:'Peso (kg)', value:''})),
      el('div',{style:'width:110px'}, el('input',{type:'text', placeholder:'Descanso (s)', value:''}))
    );
    seriesConfigArea.appendChild(row);
  }
}
seriesCountInput.addEventListener('change', buildSeriesConfig);
seriesTypeSelect.addEventListener('change', ()=>{/* could adapt UI per type */});

confirmAddExercise.addEventListener('click', ()=>{
  if(!modalContext.selectedExerciseName){ alert('Selecciona un ejercicio primero'); return; }
  const week = state.weeks.find(w=>w.id===modalContext.weekId);
  if(!week) return;
  const day = week.days.find(d=>d.id===modalContext.dayId);
  if(!day) return;
  const series = Array.from(seriesConfigArea.children).map(r=>{
    const inputs = r.querySelectorAll('input');
    return {reps:inputs[0].value || '', weight:inputs[1].value || '', rest:inputs[2].value || ''};
  });
  const exObj = {
    id: modalContext.editingExerciseId || uid('ex'),
    name: modalContext.selectedExerciseName,
    seriesType: seriesTypeSelect.value,
    series,
    notes: ''
  };
  if(modalContext.editingExerciseId){
    const idx = day.exercises.findIndex(e=>e.id===modalContext.editingExerciseId);
    if(idx>=0) day.exercises[idx] = exObj;
  } else {
    day.exercises.push(exObj);
  }
  saveState(); renderDays(); closeModal();
});

/* Editar ejercicio existente */
function editExercise(weekId,dayId,exId){
  const w = state.weeks.find(w=>w.id===weekId);
  const d = w.days.find(x=>x.id===dayId);
  const ex = d.exercises.find(x=>x.id===exId);
  if(!ex) return;
  openAddExerciseModal(weekId,dayId,exId);
  setTimeout(()=>{
    selectExercise(ex.name);
    seriesCountInput.value = ex.series.length;
    seriesTypeSelect.value = ex.seriesType || 'lineal';
    buildSeriesConfig();
    Array.from(seriesConfigArea.children).forEach((r,i)=>{
      const inputs = r.querySelectorAll('input');
      const s = ex.series[i] || {};
      inputs[0].value = s.reps || s.time || '';
      inputs[1].value = s.weight || '';
      inputs[2].value = s.rest || '';
    });
  },50);
}

function removeExercise(weekId,dayId,exId){
  if(!confirm('Eliminar este ejercicio?')) return;
  const w = state.weeks.find(w=>w.id===weekId);
  const d = w.days.find(x=>x.id===dayId);
  d.exercises = d.exercises.filter(e=>e.id!==exId);
  saveState(); renderDays();
}

/* ======= Ejercicios globales (listado y personalizados) ======= */
const exercisesModal = document.getElementById('exercisesModal');
const globalExerciseList = document.getElementById('globalExerciseList');
const globalExerciseSearch = document.getElementById('globalExerciseSearch');
const customExerciseName = document.getElementById('customExerciseName');
const saveCustomExercise = document.getElementById('saveCustomExercise');
const clearCustomExercise = document.getElementById('clearCustomExercise');

document.getElementById('openExercisesBtn').addEventListener('click', ()=>{ openExercisesModal(); });
document.getElementById('closeExercisesModal').addEventListener('click', ()=>{ exercisesModal.style.display='none'; });

function openExercisesModal(){ exercisesModal.style.display='flex'; renderGlobalExercises(); }

function renderGlobalExercises(filter=''){
  globalExerciseList.innerHTML = '';
  const list = state.exercises.filter(e=>e.toLowerCase().includes(filter.toLowerCase()));
  list.forEach((name,idx)=>{
    const row = el('div',{class:'exercise-row'}, el('div',{}, el('div',{}, name), el('div',{class:'small'}, '')), el('div',{}, el('button',{class:'btn ghost', onclick:()=>copyExerciseToClipboard(name)}, 'Copiar')));
    globalExerciseList.appendChild(row);
  });
  if(list.length===0) globalExerciseList.appendChild(el('div',{class:'small'}, 'No se encontraron ejercicios'));
}
globalExerciseSearch.addEventListener('input', ()=>renderGlobalExercises(globalExerciseSearch.value));

saveCustomExercise.addEventListener('click', ()=>{
  const name = customExerciseName.value.trim();
  if(!name){ alert('Escribe un nombre para el ejercicio'); return; }
  state.exercises.unshift(name);
  saveState();
  customExerciseName.value='';
  renderGlobalExercises();
  alert('Ejercicio personalizado guardado');
});
clearCustomExercise.addEventListener('click', ()=>{ customExerciseName.value=''; });

function copyExerciseToClipboard(name){
  navigator.clipboard?.writeText(name).then(()=>alert('Ejercicio copiado al portapapeles'));
}

/* ======= Nombre de usuario ======= */
saveNameBtn.addEventListener('click', ()=>{
  const v = nameInput.value.trim();
  state.name = v;
  localStorage.setItem(NAME_KEY, v);
  saveState();
  renderHeaderName();
});

/* ======= Reset datos ======= */
document.getElementById('resetBtn').addEventListener('click', ()=>{
  if(!confirm('¿Restablecer todos los datos guardados? Esto eliminará semanas, días y ejercicios personalizados.')) return;
  localStorage.removeItem(STORAGE_KEY);
  localStorage.removeItem(EXERCISES_KEY);
  localStorage.removeItem(NAME_KEY);
  location.reload();
});

/* ======= Abrir modal añadir personalizado desde modal de añadir ejercicio ======= */
addCustomExerciseBtn.addEventListener('click', ()=>{
  exercisesModal.style.display='flex';
  exerciseModal.style.display='none';
});

/* ======= Guardar ejercicios personalizados en estado y localStorage ======= */
window.addEventListener('beforeunload', ()=>{ saveState(); });

/* ======= Exportar / Importar / Compartir ======= */
const fileInput = document.getElementById('fileInput');
document.getElementById('exportBtn').addEventListener('click', exportData);
document.getElementById('importBtn').addEventListener('click', ()=>fileInput.click());
document.getElementById('downloadHtmlBtn').addEventListener('click', downloadHTML);
document.getElementById('shareDataBtn').addEventListener('click', copyDataToClipboard);
fileInput.addEventListener('change', handleFileImport);

function exportData(){
  try{
    const dataStr = JSON.stringify(state, null, 2);
    const blob = new Blob([dataStr], {type: 'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'plan-entrenamiento.json';
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }catch(e){ alert('Error al exportar: ' + e.message); }
}

function handleFileImport(e){
  const file = e.target.files && e.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(ev){
    try{
      const parsed = JSON.parse(ev.target.result);
      if(!confirm('¿Importar datos desde este archivo? Esto reemplazará los datos actuales.')) return;
      state = parsed;
      saveState();
      renderWeeks(); renderDays(); renderHeaderName(); renderExerciseList(); renderGlobalExercises();
      alert('Datos importados correctamente');
    }catch(err){ alert('Archivo inválido: ' + err.message); }
  };
  reader.readAsText(file);
  // reset input
  e.target.value = '';
}

function copyDataToClipboard(){
  try{
    const dataStr = JSON.stringify(state);
    navigator.clipboard.writeText(dataStr).then(()=>{
      alert('JSON copiado al portapapeles. Puedes pegarlo en un mensaje o guardarlo en un archivo.');
    }, ()=>{ prompt('Copia manualmente el JSON:', dataStr); });
  }catch(e){ alert('Error al copiar: ' + e.message); }
}

function downloadHTML(){
  try{
    // Construye el HTML actual como texto (incluye el contenido del documento)
    const doc = document.documentElement.outerHTML;
    const blob = new Blob([doc], {type: 'text/html'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'planificador-entrenamientos.html';
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }catch(e){ alert('Error al descargar HTML: ' + e.message); }
}

/* ======= Inicial render ======= */
renderWeeks();
renderDays();
renderHeaderName();
renderExerciseList();
renderGlobalExercises();

/* ======= Botones auxiliares ======= */
document.getElementById('renameWeekBtn').addEventListener('click', ()=>{
  if(!activeWeekId) return alert('Selecciona una semana primero');
  renameWeek(activeWeekId);
});
document.getElementById('deleteWeekBtn').addEventListener('click', ()=>{
  if(!activeWeekId) return alert('Selecciona una semana primero');
  deleteWeek(activeWeekId);
});
</script>
